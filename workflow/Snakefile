# Configuration


configfile: "../config/config.yaml"


# Global shell settings

shell.prefix("""
set -euo pipefail;
""")

# Load SRA Accession list

with open("../" + config["input"]["accession_list"]) as f:
    SAMPLES = [line.strip() for line in f if line.strip()]

# Included rules


include: "rules/sra.smk"
include: "rules/fastqc.smk"
include: "rules/fastp.smk"
include: "rules/megahit.smk"
include: "rules/quast.smk"
include: "rules/rgi.smk"
include: "rules/seqtk.smk"
include: "rules/mobileelementfinder.smk"
include: "rules/genomad.smk"
include: "rules/minimap2.smk"


# Final Targets


rule all:
    input:
        # Raw QC
        expand("results/fastqc/raw/{sample}_R1_fastqc.html", sample=SAMPLES),
        expand("results/fastqc/raw/{sample}_R2_fastqc.html", sample=SAMPLES),
        # Trimmed Reads
        expand("results/trimmed/{sample}_R1.fastq.gz", sample=SAMPLES),
        expand("results/trimmed/{sample}_R2.fastq.gz", sample=SAMPLES),
        expand("results/trimmed/{sample}.html", sample=SAMPLES),
        expand("results/trimmed/{sample}.json", sample=SAMPLES),
        # Trimmed QC
        expand("results/fastqc/trimmed/{sample}_R1_fastqc.html", sample=SAMPLES),
        expand("results/fastqc/trimmed/{sample}_R2_fastqc.html", sample=SAMPLES),
        # Assembly
        expand("results/assembly/{sample}/final.contigs.fa", sample=SAMPLES),
        # QUAST
        expand("results/quast/{sample}/report.tsv", sample=SAMPLES),
        # RGI Outputs
        expand("results/rgi/{sample}_rgi.txt", sample=SAMPLES),
        expand("results/rgi/{sample}.bed", sample=SAMPLES),
        expand("results/rgi/{sample}_contigs.txt", sample=SAMPLES),
        #seqtk
        expand("results/rgi/{sample}_ARG_contigs.fa", sample=SAMPLES),
        # MobileElementFinder
        expand("results/mobileelementfinder/{sample}/report.tsv", sample=SAMPLES),
        # geNomad
        expand("results/genomad/{sample}", sample=SAMPLES),
        # Mapping
        expand("results/mapping/{sample}.bam", sample=SAMPLES),
        # BAM Index
        expand("results/mapping/{sample}.bam.bai", sample=SAMPLES),
